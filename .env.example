# Environment Configuration
# Crime Intelligence Dashboard System

# ============================================================================
# Database Configuration
# ============================================================================

DATABASE_URL=postgresql://crime_user:secure_password@localhost:5432/crime_intelligence
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# PostGIS Configuration
POSTGIS_ENABLED=true
SPATIAL_INDEX_BUFFER_KM=1.0

# ============================================================================
# Cache Configuration (Redis)
# ============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=3600
HOTSPOT_CACHE_TTL=7200

# ============================================================================
# API Configuration
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# FastAPI Documentation
API_TITLE=Crime Intelligence Dashboard API
API_VERSION=1.0.0
API_DESCRIPTION=ML-powered crime classification and analysis

# ============================================================================
# ML Model Configuration
# ============================================================================

MODEL_TYPE=RandomForest
MODEL_N_ESTIMATORS=100
MODEL_MAX_DEPTH=15
MODEL_MIN_SAMPLES_SPLIT=5
MODEL_RANDOM_STATE=42
MODEL_CLASS_WEIGHT=balanced

MODEL_PATH=models/crime_classifier.pkl
FEATURES_PATH=models/feature_names.pkl

# ============================================================================
# Data Configuration
# ============================================================================

DATA_PATH=data/crime_data.csv
DATA_ANONYMIZE=true
DATA_PII_COLUMNS=Name,Phone,Email,Address,VictimID,OfficerID

# Feature Engineering
LOCATION_ENCODING_TYPE=ordinal
TEMPORAL_AGGREGATION_LEVEL=hour

# ============================================================================
# Audit & Compliance
# ============================================================================

AUDIT_LOG_PATH=logs/audit_trail.jsonl
AUDIT_LOG_ROTATION_SIZE=1000000
AUDIT_LOG_RETENTION_DAYS=3650

# Compliance Settings
ENABLE_AUDIT_LOGGING=true
ENABLE_DATA_ANONYMIZATION=true
REQUIRE_HTTPS=false  # Set to true in production

# ============================================================================
# Authentication & Authorization
# ============================================================================

JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# RBAC (Role-Based Access Control)
RBAC_ENABLED=true
DEFAULT_ROLE=field_officer

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/application.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# ============================================================================
# Streamlit Configuration
# ============================================================================

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_CLIENT_TOOLBAR_MODE=viewer
STREAMLIT_LOGGER_LEVEL=info

# ============================================================================
# Security Configuration
# ============================================================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=3600

# ============================================================================
# Performance & Monitoring
# ============================================================================

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Query Timeouts
DATABASE_QUERY_TIMEOUT_SECONDS=30
API_REQUEST_TIMEOUT_SECONDS=30

# ============================================================================
# Feature Flags
# ============================================================================

FEATURE_HOTSPOT_ANALYSIS=true
FEATURE_XAI_EXPLANATIONS=true
FEATURE_BATCH_PREDICTIONS=true
FEATURE_MODEL_RETRAINING=true
FEATURE_AUDIT_REPORTS=true

# ============================================================================
# Environment
# ============================================================================

ENVIRONMENT=development
DEBUG=true
